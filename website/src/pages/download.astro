---
import Site from '../layouts/Site.astro';
import Verification from '../components/Verification.astro';
import { metadata, path, repository } from '../lib';
const release = metadata.productionRelease;
---
<Site title="Download" description="Linux x86_64 Debian release availability, installation, SHA-256 and GPG verification, and GitHub build provenance.">
  <div class="hero prose"><p class="eyebrow">Official distribution</p><h1>Download openDownloader</h1><p class="lede">GitHub Releases is the canonical source for binaries and release evidence.</p></div>
  <section aria-labelledby="availability"><h2 id="availability">Production release</h2><div class="platforms"><div class="panel"><h3>Linux x86_64</h3><p>Debian package (.deb)</p>{release ? <><p><strong>Latest stable release: {release.tag}</strong><br />Published {release.publishedAt.slice(0, 10)}</p><div class="actions"><a class="button primary" href={release.deb.url}>Download {release.tag}</a></div><a href={release.releaseUrl}>Release notes & verification files ↗</a></> : <><p>{metadata.sourceStatus === 'ok' ? 'Latest production release will be available on GitHub Releases.' : 'Release information is unavailable for this build.'}</p><div class="actions"><a class="button primary" href={`${repository}/releases`}>See GitHub Releases</a></div></>}</div><div class="panel"><h3>Windows</h3><p>Not currently distributed.</p><p class="fine">x86_64 portability and unsigned packaging checks only.</p></div><div class="panel"><h3>macOS</h3><p>Not currently distributed.</p><p class="fine">Intel portability and unsigned packaging checks only.</p></div></div><p class="fine">Verify signatures, checksums, and provenance before installation. Published filenames alone do not authenticate a package.</p></section>
  <section class="prose" aria-labelledby="installation"><h2 id="installation">Install on Debian-based Linux</h2>{release ? <><p>After verifying the downloaded package:</p><pre tabindex="0" role="region" aria-label="Debian installation command"><code>{`sudo apt install ./${release.deb.name}`}</code></pre><p>Open openDownloader from the desktop application menu.</p></> : <p>Exact installation commands will appear when a qualifying Debian release is published. Historical AppImage and ZIP releases are not the current production package format.</p>}<a href={path('docs/getting-started/')}>Continue with Getting Started →</a></section>
  <section id="verification" class="prose" aria-labelledby="verify"><h2 id="verify">Verify before installing</h2><Verification /></section>
  {metadata.latestPublicRelease?.historical && <section aria-labelledby="historical"><h2 id="historical">Historical releases</h2><p>Newest public historical release: <a href={metadata.latestPublicRelease.releaseUrl}>{metadata.latestPublicRelease.tag}</a>. Its assets do not satisfy the current signed Debian production contract.</p><a href={path('releases/')}>Release status →</a></section>}
</Site>
